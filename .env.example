# LeaveClaude 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
LEAVE_HOST=127.0.0.1
LEAVE_PORT=7437

# ── Logging ───────────────────────────────────────────────────
LEAVE_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
LEAVE_LOG_FILE=~/.leave/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
LEAVE_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# LEAVE_CONFIG=~/.leave/config.toml

# ── LLM（S1 阶段启用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# LEAVE_LLM_MODEL=claude-sonnet-4-6
# LEAVE_MAX_STEPS=20
